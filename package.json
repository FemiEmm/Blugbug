{
  "name": "chatter",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:server": "node --env-file-if-exists=.env.local --watch server/index.js",
    "start:server": "node --env-file-if-exists=.env.local server/index.js",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test": "npm run test:server",
    "test:server": "node --test server/tests/*.test.js",
    "build-only": "vite build",
    "type-check": "vue-tsc --noEmit -p tsconfig.app.json",
    "lint": "npm run type-check",
    "format": "prettier --write src/ server/",
    "supabase:push:dry": "node --env-file=.env.local scripts/push-local-to-supabase.mjs",
    "supabase:push": "node --env-file=.env.local scripts/push-local-to-supabase.mjs --apply"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.6.0",
    "@fortawesome/fontawesome-svg-core": "^6.6.0",
    "@fortawesome/free-solid-svg-icons": "^6.6.0",
    "@fortawesome/vue-fontawesome": "^3.0.8",
    "@supabase/supabase-js": "^2.112.3",
    "better-sqlite3": "^13.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "file-type": "^22.0.2",
    "multer": "^2.2.0",
    "sanitize-html": "^2.17.7",
    "vue": "^3.5.41",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@tsconfig/node20": "^20.1.4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.10.0",
    "@types/sanitize-html": "^2.16.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/compiler-sfc": "^3.5.41",
    "@vue/tsconfig": "^0.9.1",
    "concurrently": "^10.0.5",
    "npm-run-all2": "^6.2.0",
    "prettier": "^3.9.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vue-tsc": "^3.3.10"
  }
}
