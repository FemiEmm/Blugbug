# Required by the browser app (also add these in Netlify environment variables)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key
VITE_SITE_URL=http://localhost:5173

# Optional laptop backup API. The deployed browser app does not use these.
LOCAL_HOST=127.0.0.1
LOCAL_API_PORT=3001
LOCAL_LOGIN_USERNAME=admin
LOCAL_LOGIN_PASSWORD=change-me

# Migration scripts only. Never expose this as a VITE_ variable or in Netlify.
SUPABASE_SERVICE_ROLE_KEY=your-secret-or-service-role-key

# Netlify Function only. Add this as a secret Netlify environment variable.
# Use a Supabase Secret API key (preferred) or the legacy service_role key.
SUPABASE_SECRET_KEY=your-server-only-secret-key
